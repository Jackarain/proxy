#include <winresrc.h>

#pragma code_page(65001)

wintun.cat RCDATA "@PROXY_RESOURCE_DIR@/driver/wintun.cat"
wintun.inf RCDATA "@PROXY_RESOURCE_DIR@/driver/wintun.inf"
wintun.sys RCDATA "@PROXY_RESOURCE_DIR@/driver/wintun.sys"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "proxy"
            VALUE "FileDescription", "proxy"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "proxy"
            VALUE "OriginalFilename", "proxy_server.exe"
            VALUE "ProductName", "proxy"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
