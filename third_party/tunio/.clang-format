BasedOnStyle: LLVM

# 1. 单行最大字符数限制为 120 列
ColumnLimit: 80

# 2. 基础缩进：设置为 4 个空格
IndentWidth: 4

# 3. 访问修饰符（public/private/protected）与 class 关键字左对齐
AccessModifierOffset: -4

# 4. 构造函数初始化列表风格设置
PackConstructorInitializers: Never           # 禁止将成员初始化塞在同一行，强制多行排列
BreakConstructorInitializers: BeforeComma    # 冒号和逗号在行首前置对齐
ConstructorInitializerIndentWidth: 4         # 初始化列表相对于函数的缩进格数

# 5. 强制函数大括号折行（禁止单行短函数）
AllowShortFunctionsOnASingleLine: None

# 6. 大括号换行规则
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true   # 函数大括号独占一行
  AfterClass: true      # 类 (class) 大括号独占一行
  AfterStruct: true     # 结构体 (struct) 大括号独占一行
